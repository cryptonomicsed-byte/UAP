{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uap.local/contracts/v1/lease.schema.json",
  "title": "UAP task lease (uap-lease/1)",
  "description": "A signed, time-bounded delegation of one task to one SID under one grant. The document is signed over \"uap-lease/1\\n\" + canonical JSON; the signature is not inside the document. Field order in `required` is the canonical bytes order and is checked against the producer.",
  "x-uap-domain": "uap-lease/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "lease_id",
    "task_id",
    "tenant",
    "sid",
    "role_digest",
    "grant_id",
    "epoch",
    "issued_at_ms",
    "expires_at_ms",
    "revocation",
    "nonce"
  ],
  "properties": {
    "v": { "const": "uap-lease/1" },
    "lease_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "tenant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "sid": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "role_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "grant_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "issued_at_ms": { "type": "integer", "minimum": 0 },
    "expires_at_ms": { "type": "integer", "minimum": 0 },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "version"],
      "properties": {
        "list": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
        "version": { "type": "integer", "minimum": 0 }
      }
    },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
