{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uap.local/contracts/v1/grant.schema.json",
  "title": "UAP authority grant (uap-grant/1)",
  "description": "What a SID may do: effect classes, resource patterns, schema-pinned tools, a risk ceiling and a budget. Signed by an issuer over \"uap-grant/1\\n\" + canonical JSON. Field order in `required` is the canonical bytes order and is checked against the producer.",
  "x-uap-domain": "uap-grant/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "grant_id",
    "tenant",
    "sid",
    "effects",
    "resources",
    "tools",
    "max_risk",
    "budget",
    "issued_at_ms",
    "expires_at_ms",
    "epoch"
  ],
  "properties": {
    "v": { "const": "uap-grant/1" },
    "grant_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "tenant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "sid": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read",
          "compute",
          "write",
          "external_message",
          "money",
          "publish",
          "production_change",
          "security_testing",
          "clinical_data"
        ]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(tool|file|http_origin|repo|database|cloud_account|model|vault_secret|queue|dataset):\\S+$" }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "schema"],
        "properties": {
          "tool": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "schema": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "max_risk": { "enum": ["low", "medium", "high", "critical"] },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "wall_ms", "spend"],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1 },
        "wall_ms": { "type": "integer", "minimum": 1 },
        "spend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_ms", "ram_mib", "gpu_ms", "cloud_micros", "events"],
          "properties": {
            "cpu_ms": { "type": "integer", "minimum": 0 },
            "ram_mib": { "type": "integer", "minimum": 0 },
            "gpu_ms": { "type": "integer", "minimum": 0 },
            "cloud_micros": { "type": "integer", "minimum": 0 },
            "events": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "issued_at_ms": { "type": "integer", "minimum": 0 },
    "expires_at_ms": { "type": "integer", "minimum": 0 },
    "epoch": { "type": "integer", "minimum": 1 }
  }
}
